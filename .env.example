# Database (Railway managed Postgres)
DATABASE_URL=postgresql://user:password@host:5432/engram

# Encryption — 32-byte hex key for AES-256-GCM
ENCRYPTION_KEY=your_64_hex_chars_here

# ElevenLabs Scribe v2
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# LLM provider (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-5.4-mini-2026-03-17

# Cloudflare R2 / S3-compatible storage
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET=engram

# Better Auth
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Public app URL (must match BETTER_AUTH_URL; used by the auth client on the browser)
# Also forms the Plaud OAuth redirect URI: <NEXT_PUBLIC_APP_URL>/api/plaud/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Native macOS recorder upload authorization (generate with: openssl rand -hex 32)
MAC_RECORDER_API_TOKEN=your_mac_recorder_api_token_here

# Phase 1 ownership bridge. This must be the existing Better Auth user ID chosen
# by the audited backfill; the temporary legacy token is never a global identity.
LEGACY_MAC_RECORDER_OWNER_ID=your_existing_better_auth_user_id
AUTH_LEGACY_MAC_ENABLED=true

# Temporary rollback compatibility for ownership release A only. Enable before
# the first owner-aware deploy, then remove after the backfill audit is all zero.
AUTH_ALLOW_UNOWNED_LEGACY_DATA=false

# Phase 2 switch: gates OAuth endpoints, discovery, and bearer acceptance together.
# Keep false until migration 0011 is applied and the Mac client is provisioned.
AUTH_OAUTH_BEARER_ENABLED=false
MCP_ENABLED=false
